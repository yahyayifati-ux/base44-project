# Development placeholders so the stack boots without any credentials.
# Listed FIRST under `env_file:` in docker-compose.base44.yml, so real values
# delivered by the platform (/run/base44/app.env) always win.
#
# These are throwaway local values, not production credentials.

# Signing key for admin session tokens. The platform delivers a generated
# value to /run/base44/app.env which overrides this placeholder.
SECRET_KEY=base44-dev-placeholder-secret-key-not-for-production

# Seeded administrator account for the local preview. Change the password
# from the admin dashboard (تنظیمات → تغییر رمز عبور) once you are in.
ADMIN_EMAIL=admin@javid.local
ADMIN_PASSWORD=javid-dev-1404
ADMIN_NAME=مدیر املاک جاوید
